# Beszel agent configuration for the Magisk module.
#
# Live file: /data/adb/beszel-agent/beszel-agent.env
# /data/adb/modules/beszel-agent/.env is a symlink to it, so editing either path
# edits the same file. It is kept outside /data/adb/modules on purpose: Magisk
# wipes a module directory every time the module is reinstalled/updated.
#
# Do not use /var/lib on Android: it is not writable/persistent.

# Public key shown when adding a system in the Hub
KEY=ssh-ed25519 AAAA...your-public-key...

# Agent token (from Hub /settings/tokens or the add-system dialog)
TOKEN=your-token-here

# Hub base URL (include scheme and port)
HUB_URL=http://127.0.0.1:8090

# Optional: path used for root filesystem / disk I/O stats (default: /data)
# FILESYSTEM=/data

# Optional: persistent agent state dir (fingerprint). Default:
#   /data/adb/beszel-agent/data
# Must be writable and survive reboot.
# DATA_DIR=/data/adb/beszel-agent/data